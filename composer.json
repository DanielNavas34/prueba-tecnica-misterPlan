{
    "name": "danielnavas34/prueba-tecnica-misterplan",
    "description": "Gestión de reservas de alojamiento — prueba técnica PHP nativo",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    }
}
